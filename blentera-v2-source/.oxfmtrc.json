{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "overrides": [
    {
      "files": ["*.css"],
      "options": { "singleQuote": false }
    }
  ],
  "ignorePatterns": [
    ".next/",
    "coverage/",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    ".claude/skills/",
    "skills-lock.json",
    ".agents/skills/"
  ]
}
