# The public origin, such as https://example.com, for canonicals, the sitemap and JSON-LD.
# Read at build time. On Vercel it defaults to the production domain.
SITE_URL=

# Set to production on hosts other than Vercel, with SITE_URL, so the site is indexed.
# Read at build time. Everything else stays noindex.
SITE_ENV=

# Token from your 7Ovr account, only needed to install Pro blocks.
REGISTRY_TOKEN=
